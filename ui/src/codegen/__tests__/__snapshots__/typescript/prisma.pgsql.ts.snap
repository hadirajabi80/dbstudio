// Prisma schema generated by DbStudio from PostgreSQL.
// Review relation names and run `npx prisma validate`; `npx prisma db pull` introspects the live database.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "sales"]
}

/// ISO countries
model Country {
  id        Int        @id @default(autoincrement())
  name      String
  /// ISO 3166-1 alpha-2
  isoCode   String     @db.Char(2) @map("iso_code")
  customers Customer[]

  @@map("countries")
  @@schema("public")
}

/// People who buy things
/// tags is a nullable array: Prisma lists cannot be optional
model Customer {
  id        BigInt    @id @default(autoincrement())
  /// Display name
  name      String    @db.VarChar(100)
  email     String?
  countryId Int?      @map("country_id")
  isActive  Boolean   @default(dbgenerated()) @map("is_active")
  createdAt DateTime  @db.Timestamptz(6) @default(now()) @map("created_at")
  /// Free-form preferences
  profile   Json?
  tags      String[]
  country   Country?  @relation(fields: [countryId], references: [id], map: "customers_country_id_fkey")
  orders    Order[]
  invoices  Invoice[]

  @@map("customers")
  @@schema("public")
}

model Product {
  id         Int         @id @default(autoincrement())
  sku        String      @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  name       String
  price      Decimal     @db.Decimal(10, 2)
  stock      Int         @default(dbgenerated())
  attributes Json?
  thumbnail  Bytes?
  orderLines OrderLine[]

  @@map("products")
  @@schema("public")
}

model Order {
  id         BigInt      @id @default(autoincrement())
  customerId BigInt      @map("customer_id")
  orderDate  DateTime    @db.Timestamptz(6) @default(now()) @map("order_date")
  status     OrderStatus @default(dbgenerated())
  total      Decimal     @db.Decimal(12, 2)
  note       String?
  customer   Customer    @relation(fields: [customerId], references: [id], map: "orders_customer_id_fkey")
  orderLines OrderLine[]

  @@map("orders")
  @@schema("public")
}

/// line_total is a generated column (read-only; Prisma cannot declare it, writes are rejected by the server)
model OrderLine {
  orderId   BigInt   @map("order_id")
  lineNo    Int      @map("line_no")
  productId Int      @map("product_id")
  qty       Int
  unitPrice Decimal  @db.Decimal(10, 2) @map("unit_price")
  /// GENERATED ALWAYS AS (qty * unit_price) STORED
  lineTotal Decimal? @db.Decimal(12, 2) @map("line_total")
  order     Order    @relation(fields: [orderId], references: [id], map: "order_lines_order_id_fkey")
  product   Product  @relation(fields: [productId], references: [id], map: "order_lines_product_id_fkey")

  @@id([orderId, lineNo])
  @@map("order_lines")
  @@schema("public")
}

/// One column per PostgreSQL type family
/// counts is a nullable array: Prisma lists cannot be optional
/// statuses is a nullable array: Prisma lists cannot be optional
model TypeZoo {
  id        String                    @id @db.Uuid
  small     Int?                      @db.SmallInt
  big       BigInt?
  ratio     Float?                    @db.Real
  score     Float?
  price     Decimal?                  @db.Money
  code      String?                   @db.VarChar(20)
  day       DateTime?                 @db.Date
  atLocal   DateTime?                 @db.Timestamp(3) @map("at_local")
  opens     DateTime?                 @db.Time(6)
  opensTz   DateTime?                 @db.Timetz(6) @map("opens_tz")
  wait      Unsupported("interval")?
  doc       Json?                     @db.Json
  spec      String?                   @db.Xml
  ip        String?                   @db.Inet
  mac       Unsupported("macaddr")?
  location  Unsupported("point")?
  search    Unsupported("tsvector")?
  during    Unsupported("tstzrange")?
  counts    Int[]
  statuses  OrderStatus[]
  /// Reserved word as a column name
  user      String?
  /// Mixed case needs quoting
  camelCase String?                   @map("CamelCase")

  @@map("type_zoo")
  @@schema("public")
}

/// The underlying view has no primary key: Prisma Client ignores it until a field is marked @id or @unique (then remove @@ignore).
view CustomerTotal {
  customerId BigInt?  @map("customer_id")
  name       String?  @db.VarChar(100)
  orders     BigInt?
  revenue    Decimal?

  @@map("customer_totals")
  @@schema("public")
  @@ignore
}

/// Issued invoices
model Invoice {
  invoiceId  BigInt   @id @default(autoincrement()) @map("invoice_id")
  customerId BigInt   @map("customer_id")
  issuedAt   DateTime @db.Timestamptz(6) @default(now()) @map("issued_at")
  amount     Decimal  @db.Decimal(12, 2)
  paid       Boolean  @default(dbgenerated())
  pdf        Bytes?
  customer   Customer @relation(fields: [customerId], references: [id], map: "invoices_customer_id_fkey")

  @@map("invoices")
  @@schema("sales")
}

enum OrderStatus {
  new
  paid
  shipped
  cancelled

  @@map("order_status")
  @@schema("public")
}
