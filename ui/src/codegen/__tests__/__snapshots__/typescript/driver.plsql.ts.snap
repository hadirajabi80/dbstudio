}

/** Calls SHOP.GET_CUSTOMER_ORDERS. */
export async function getCustomerOrders(conn: oracledb.Connection, customerId: number): Promise<GetCustomerOrdersResult> {
  const result = await conn.execute<{ P_ORDERS: oracledb.ResultSet<Record<string, unknown>> }>(`BEGIN SHOP.GET_CUSTOMER_ORDERS(P_CUSTOMER_ID => :P_CUSTOMER_ID, P_ORDERS => :P_ORDERS); END;`, {
    P_CUSTOMER_ID: customerId,
    P_ORDERS: { dir: oracledb.BIND_OUT, type: oracledb.CURSOR },
  }, { outFormat: oracledb.OUT_FORMAT_OBJECT });
  const out = result.outBinds!;
  const ordersCursor = out.P_ORDERS;
  const ordersRows = await ordersCursor.getRows();
  await ordersCursor.close();
  return {
    orders: ordersRows,
  };
}

