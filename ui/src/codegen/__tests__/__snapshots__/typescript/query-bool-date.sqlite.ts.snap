// Generated by Rowlit from SQLite: ActiveSince. Review before use.

import type { Database } from 'better-sqlite3';

/** A SQLite timestamp as a Date: text 'YYYY-MM-DD HH:MM:SS[.SSS]' is UTC (ISO text with 'T', 'Z' or an offset is read as written); a number is unix seconds (> 1e8) or a julian day. */
function fromSqliteDateTime(v: string | number): Date {
  if (typeof v === 'number') return new Date(v > 1e8 ? v * 1000 : (v - 2440587.5) * 86400000);
  const iso = v.length === 10 ? `${v}T00:00:00` : v.replace(' ', 'T');
  return new Date(/(Z|[+-]\d\d:?\d\d)$/i.test(iso) ? iso : `${iso}Z`);
}

/** The local calendar day of a Date as SQLite DATE text 'YYYY-MM-DD'. */
function toSqliteDate(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

/** A Date as SQLite's UTC timestamp text 'YYYY-MM-DD HH:MM:SS' (CURRENT_TIMESTAMP's format), with '.SSS' when it has milliseconds. */
function toSqliteDateTime(d: Date): string {
  return d.toISOString().replace('T', ' ').replace(/\.000Z$/, '').replace(/Z$/, '');
}

/** Row of the ActiveSince query. */
export interface ActiveSinceRow {
  id: number;
  isActive: boolean;
  createdAt: Date | null;
  total: number;
}

const getActiveSinceSql = `SELECT Id, IsActive, CreatedAt, Total FROM Orders WHERE IsActive = :active AND CreatedAt > :since AND OrderDate = :day AND Total > :min`;

// Rows arrive keyed by column name; Id -> id, IsActive -> isActive, CreatedAt -> createdAt, Total -> total are mapped below.
/** Runs the ActiveSince query. */
export function getActiveSince(db: Database, active: boolean, since: Date, day: Date, min: number): ActiveSinceRow[] {
  const rows = db.prepare<unknown[], Record<string, unknown>>(getActiveSinceSql).all({ active: Number(active), since: toSqliteDateTime(since), day: toSqliteDate(day), min });
  return rows.map((r) => ({ id: r["Id"] as number, isActive: r["IsActive"] === 1, createdAt: r["CreatedAt"] == null ? null : fromSqliteDateTime(r["CreatedAt"] as string | number), total: r["Total"] as number }));
}
