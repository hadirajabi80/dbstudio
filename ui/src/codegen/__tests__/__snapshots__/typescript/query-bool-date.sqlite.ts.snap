// Generated by DbStudio from SQLite: ActiveSince. Review before use.

import type { Database } from 'better-sqlite3';

/** SQLite timestamp text ('YYYY-MM-DD HH:MM:SS', UTC) as a Date; ISO text with 'T', 'Z' or an offset is read as written. */
function fromSqliteDateTime(s: string): Date {
  const iso = s.length === 10 ? `${s}T00:00:00` : s.replace(' ', 'T');
  return new Date(/(Z|[+-]\d\d:?\d\d)$/i.test(iso) ? iso : `${iso}Z`);
}

/** The local calendar day of a Date as SQLite DATE text 'YYYY-MM-DD'. */
function toSqliteDate(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

/** A Date as SQLite's UTC timestamp text 'YYYY-MM-DD HH:MM:SS' (the format CURRENT_TIMESTAMP writes). */
function toSqliteDateTime(d: Date): string {
  return d.toISOString().replace('T', ' ').replace(/\.\d{3}Z$/, '');
}

/** Row of the ActiveSince query. */
export interface ActiveSinceRow {
  id: number;
  isActive: boolean;
  createdAt: Date | null;
  total: number;
}

const activeSinceSql = `SELECT Id, IsActive, CreatedAt, Total FROM Orders WHERE IsActive = :active AND CreatedAt > :since AND OrderDate = :day AND Total > :min`;

// Rows arrive keyed by column name; Id -> id, IsActive -> isActive, CreatedAt -> createdAt, Total -> total are mapped below.
/** Runs the ActiveSince query. */
export function activeSince(db: Database, active: boolean, since: Date, day: Date, min: number): ActiveSinceRow[] {
  const rows = db.prepare<unknown[], Record<string, unknown>>(activeSinceSql).all({ active: Number(active), since: toSqliteDateTime(since), day: toSqliteDate(day), min });
  return rows.map((r) => ({ id: r["Id"] as number, isActive: r["IsActive"] === 1, createdAt: r["CreatedAt"] == null ? null : fromSqliteDateTime(r["CreatedAt"] as string), total: r["Total"] as number }));
}
