}

/** Calls dbo.GetOrderTotals. */
export async function getOrderTotals(pool: sql.ConnectionPool | sql.Transaction, customerId: number, since: string | null = null): Promise<GetOrderTotalsResult> {
  const result = await pool
    .request()
    .input('CustomerId', sql.Int, customerId)
    .input('Since', sql.DateTime2, since)
    .output('Total', sql.Decimal(18, 2))
    .output('OrderCount', sql.Int)
    .execute("dbo.GetOrderTotals");
  return {
    rows: result.recordset ?? [],
    total: result.output.Total as number | null,
    orderCount: result.output.OrderCount as number | null,
    returnValue: result.returnValue,
  };
}

/** Row of the CustomerOrders query. */
export interface CustomerOrdersRow {
  id: number;
  name: string;
  total: number;
  orderDate: string | null;
}

const customerOrdersSql = `SELECT c.Id, c.Name, o.Total, o.OrderDate
FROM dbo.Customers c
JOIN dbo.Orders o ON o.CustomerId = c.Id
WHERE c.Id = @customerId AND o.Total > @minTotal
ORDER BY o.OrderDate DESC`;

// Rows arrive keyed by column name; Id -> id, Name -> name, Total -> total, OrderDate -> orderDate are mapped below.
/** Runs the CustomerOrders query. */
export async function customerOrders(pool: sql.ConnectionPool | sql.Transaction, customerId: number, minTotal: number): Promise<CustomerOrdersRow[]> {
  const result = await pool
    .request()
    .input('customerId', sql.Int, customerId)
    .input('minTotal', sql.Decimal(38, 10), minTotal)
    .query(customerOrdersSql);
  return result.recordset.map((r) => ({ id: r["Id"] as number, name: r["Name"] as string, total: r["Total"] as number, orderDate: r["OrderDate"] as string | null }));
}
