import pg, { type Pool, type PoolClient } from 'pg';

/**
 * node-postgres type parsers of the queries below, passed per query so the global pg.types stay untouched:
 * - int8 as a number (node-postgres returns it as text because values can exceed 2^53)
 * - numeric as a number (text by default; digits beyond a double are lost: set the decimal mapping to string to keep them)
 * - date kept as text (node-postgres would return a Date at local midnight)
 * - timestamp kept as text (node-postgres would return a Date)
 * - timestamptz kept as text (node-postgres would return a Date)
 * - interval kept as text (node-postgres would return an interval object)
 */
const pgTypes = new pg.TypeOverrides();
pgTypes.setTypeParser(pg.types.builtins.INT8, (v) => Number.parseInt(v, 10));
pgTypes.setTypeParser(pg.types.builtins.NUMERIC, (v) => Number.parseFloat(v));
pgTypes.setTypeParser(pg.types.builtins.DATE, (v) => v);
pgTypes.setTypeParser(pg.types.builtins.TIMESTAMP, (v) => v);
pgTypes.setTypeParser(pg.types.builtins.TIMESTAMPTZ, (v) => v);
pgTypes.setTypeParser(pg.types.builtins.INTERVAL, (v) => v);

