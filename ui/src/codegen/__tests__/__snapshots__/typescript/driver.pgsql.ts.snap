/** Row of the CustomerOrders query. */
export interface CustomerOrdersRow {
  id: number;
  name: string;
  total: number;
  orderDate: string | null;
  status: 'new' | 'paid' | 'shipped' | 'cancelled';
}

const getCustomerOrdersSql = `SELECT c.id, c.name, o.total, o.order_date, o.status
FROM customers c
JOIN orders o ON o.customer_id = c.id
WHERE c.id = $1 AND o.total > $2
ORDER BY o.order_date DESC`;

// Rows arrive keyed by column name; order_date -> orderDate are mapped below.
/** Runs the CustomerOrders query. */
export async function getCustomerOrders(pool: Pool | PoolClient, p1: number, p2: number): Promise<CustomerOrdersRow[]> {
  const result = await pool.query<Record<string, unknown>>({
    text: getCustomerOrdersSql,
    values: [p1, p2],
    types: pgTypes,
  });
  return result.rows.map((r) => ({ id: r["id"] as number, name: r["name"] as string, total: r["total"] as number, orderDate: r["order_date"] as string | null, status: r["status"] as 'new' | 'paid' | 'shipped' | 'cancelled' }));
}
