/** What public.add_order_line returns (its OUT / INOUT parameters). */
export interface AddOrderLineResult {
  lineNo: number | null;
}

/** Calls public.add_order_line(p_order_id bigint, p_product_id integer, p_qty integer = default, INOUT p_line_no integer = default). Arguments left undefined keep their defaults. */
export async function addOrderLine(pool: Pool | PoolClient, orderId: number, productId: number, qty?: number | null, lineNo?: number | null): Promise<AddOrderLineResult> {
  const values: unknown[] = [orderId, productId];
  const args: string[] = ['$1::bigint', '$2::integer'];
  if (qty !== undefined) {
    values.push(qty);
    args.push(`p_qty => $${values.length}::integer`);
  }
  if (lineNo !== undefined) {
    values.push(lineNo);
    args.push(`p_line_no => $${values.length}::integer`);
  }
  const result = await pool.query<{ p_line_no: number | null }>(`CALL public.add_order_line(${args.join(', ')})`, values);
  const row = result.rows[0];
  return {
    lineNo: row?.p_line_no ?? null,
  };
}

