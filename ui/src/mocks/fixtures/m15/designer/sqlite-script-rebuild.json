      {
        "sql": "INSERT INTO \"Orders__new\" (\"Id\", \"CustomerId\", \"OrderDate\", \"Status\", \"ShippedAt\", \"Total\", \"Note\")\nSELECT \"Id\", \"CustomerId\", \"OrderDate\", \"Status\", \"ShippedAt\", \"Total\", \"Note\"\nFROM \"Orders\"",
