exports[`exportCode > find → csharp 1`] = `
"using System.Globalization;
using MongoDB.Bson;
using MongoDB.Driver;

var client = new MongoClient("mongodb://localhost:27017");
var coll = client.GetDatabase("shop").GetCollection<BsonDocument>("orders");

var filter = new BsonDocument
{
    { "status", "paid" },
    { "total", new BsonDocument("$gt", 100) }
};
var projection = new BsonDocument { { "_id", 0 }, { "customer", 1 } };
var sort = new BsonDocument("createdAt", -1);

var results = await coll.Find(filter)
    .Project(projection)
    .Sort(sort)
    .Skip(20)
    .Limit(10)
    .ToListAsync();
foreach (var doc in results)
{
    Console.WriteLine(doc.ToJson());
}"
`;

exports[`exportCode > find → java 1`] = `
"import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import org.bson.Document;

public class Query {
    public static void main(String[] args) {
        try (MongoClient client = MongoClients.create("mongodb://localhost:27017")) {
            MongoCollection<Document> coll = client.getDatabase("shop").getCollection("orders");

            Document filter = new Document("status", "paid")
                .append("total", new Document("$gt", 100));
            Document projection = new Document("_id", 0)
                .append("customer", 1);
            Document sort = new Document("createdAt", -1);

            for (Document doc : coll.find(filter)
                    .projection(projection)
                    .sort(sort)
                    .skip(20)
                    .limit(10)) {
                System.out.println(doc.toJson());
            }
        }
    }
}"
`;

exports[`exportCode > find → node 1`] = `
"import { MongoClient } from 'mongodb';

const client = new MongoClient('mongodb://localhost:27017');
const coll = client.db('shop').collection('orders');

const filter = { status: 'paid', total: { $gt: 100 } };
const options = {
  projection: { _id: 0, customer: 1 },
  sort: { createdAt: -1 },
  skip: 20,
  limit: 10
};

const cursor = coll.find(filter, options);
for await (const doc of cursor) {
  console.log(doc);
}
await client.close();"
`;

exports[`exportCode > find → python 1`] = `
"from pymongo import MongoClient

client = MongoClient('mongodb://localhost:27017')
coll = client['shop']['orders']

filter = {'status': 'paid', 'total': {'$gt': 100}}
projection = {'_id': 0, 'customer': 1}
sort = [('createdAt', -1)]

cursor = coll.find(filter, projection=projection, sort=sort, skip=20, limit=10)
for doc in cursor:
    print(doc)"
`;

