  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbStudio.Sources.Kafka\DbStudio.Sources.Kafka.csproj" />
  </ItemGroup>

