<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile smoke test for the C# code generators (docs/PLAN-M1.5.md 1.4): every C# snapshot produced by
    ui/src/codegen/__tests__/snapshots.test.ts is compiled here with nullable reference types on, implicit
    usings off and warnings as errors. Regenerate the snapshots first with: npm run test (in ui), adding -u to update.
    Run: dotnet build engine/tests/Codegen.Smoke
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Generated wrappers intentionally expose Oracle/EF types; the analyzers are irrelevant here. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\ui\src\codegen\__tests__\__snapshots__\csharp\*.cs" LinkBase="Snapshots" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.301" />
    <!-- code-06: SqlClient 7.1.1 and ODP.NET 23.26.301 pull System.Security.Cryptography.Pkcs 9.0.18 / 8.0.1 (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7); pin the patched 10.0 servicing release, as the provider projects do. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
