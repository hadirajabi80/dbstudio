      "sql": "SELECT GET_DDL('TABLE', '\"SHOP\".\"PUBLIC\".\"ORDERS\"', TRUE) AS DDL",
      "columns": ["DDL"],
      "rows": [["create or replace TABLE SHOP.PUBLIC.ORDERS cluster by (ORDER_DATE, TO_DATE(ORDER_DATE)) (\n\tID NUMBER(38,0) NOT NULL,\n\tCUSTOMER_ID NUMBER(38,0) NOT NULL,\n\tORDER_DATE TIMESTAMP_NTZ(9) NOT NULL,\n\tTOTAL NUMBER(12,2) NOT NULL DEFAULT 0 COMMENT 'Order total incl. tax',\n\tconstraint PK_ORDERS primary key (ID),\n\tconstraint FK_ORDERS_CUSTOMERS foreign key (CUSTOMER_ID) references SHOP.PUBLIC.CUSTOMERS(ID)\n);"]]
    },
    {
      "sql": "SELECT GET_DDL('VIEW', '\"SHOP\".\"PUBLIC\".\"CUSTOMER_ORDERS\"', TRUE) AS DDL",
      "columns": ["DDL"],
      "rows": [["create or replace view SHOP.PUBLIC.CUSTOMER_ORDERS(\n\tCUSTOMER_ID,\n\tNAME,\n\tORDER_ID,\n\tTOTAL\n) COMMENT='Orders per customer'\n as\nSELECT c.ID AS CUSTOMER_ID, c.NAME, o.ID AS ORDER_ID, o.TOTAL\nFROM CUSTOMERS c JOIN ORDERS o ON o.CUSTOMER_ID = c.ID;"]]
    },
    {
      "sql": "SELECT GET_DDL('FUNCTION', '\"SHOP\".\"PUBLIC\".\"ORDER_TAX\"(NUMBER)', TRUE) AS DDL",
      "columns": ["DDL"],
      "rows": [["CREATE OR REPLACE FUNCTION SHOP.PUBLIC.ORDER_TAX(\"AMOUNT\" NUMBER(38,0))\nRETURNS NUMBER(38,2)\nLANGUAGE SQL\nAS '\n  AMOUNT * 0.19\n';"]]
    },
    {
      "sql": "SELECT GET_DDL('FUNCTION', '\"SHOP\".\"PUBLIC\".\"ORDER_TAX\"(NUMBER, VARCHAR)', TRUE) AS DDL",
      "columns": ["DDL"],
      "rows": [["CREATE OR REPLACE FUNCTION SHOP.PUBLIC.ORDER_TAX(\"AMOUNT\" NUMBER(38,0), \"COUNTRY\" VARCHAR)\nRETURNS NUMBER(38,2)\nLANGUAGE SQL\nAS '\n  IFF(COUNTRY = ''DE'', AMOUNT * 0.19, AMOUNT * 0.2)\n';"]]
