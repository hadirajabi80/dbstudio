<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Library of abstract xunit tests (ProviderConformanceTests<TFixture>) shared by the provider test projects.
    Not a test project itself: it has no concrete tests and no test host.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>DbStudio.Providers.Conformance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbStudio.Core\DbStudio.Core.csproj" />
  </ItemGroup>

</Project>
