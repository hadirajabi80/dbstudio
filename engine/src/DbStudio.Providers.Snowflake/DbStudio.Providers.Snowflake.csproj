<Project Sdk="Microsoft.NET.Sdk">

  <!-- Snowflake provider (plan-batch3 WP-SF). Snowflake.Data 6.x (no log4net since 5.0; net10.0 build): its AWS / Azure / Google
       storage SDKs serve PUT/GET stage transfers. Natives: sf_mini_core (all RIDs) and Mono.Unix (linux/osx), next to the
       macOS apphost like librdkafka (docs/wp-notes/WP-SF.md). Publish delta ~5.9 MiB. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbStudio.Core\DbStudio.Core.csproj" />
    <ProjectReference Include="..\DbStudio.Logs\DbStudio.Logs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Snowflake.Data" Version="6.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbStudio.Providers.Snowflake.Tests" />
  </ItemGroup>

</Project>
