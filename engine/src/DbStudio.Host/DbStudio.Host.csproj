<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The assembly stays DbStudio.Engine (namespaces and the DbStudio.* module discovery depend on the name); the
         build scripts publish the apphost as Rowlit.Engine.exe / Rowlit.Engine, the process name users see. -->
    <AssemblyName>DbStudio.Engine</AssemblyName>
    <!-- Version resource: Task Manager shows FileDescription (AssemblyTitle) for the engine process. -->
    <AssemblyTitle>Rowlit Engine</AssemblyTitle>
    <Product>Rowlit</Product>
    <Company>Rowlit contributors</Company>
    <Copyright>Copyright (c) 2026 Rowlit contributors</Copyright>
    <RootNamespace>DbStudio.Host</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbStudio.Core\DbStudio.Core.csproj" />
    <ProjectReference Include="..\DbStudio.Providers.Sqlite\DbStudio.Providers.Sqlite.csproj" />
    <ProjectReference Include="..\DbStudio.Providers.SqlServer\DbStudio.Providers.SqlServer.csproj" />
    <ProjectReference Include="..\DbStudio.Providers.Oracle\DbStudio.Providers.Oracle.csproj" />
    <!-- M2 (docs/PLAN-M2.md D4): feature projects; their IEngineModules are discovered at startup (ModuleAssemblies.cs). -->
    <ProjectReference Include="..\DbStudio.Providers.PostgreSql\DbStudio.Providers.PostgreSql.csproj" />
    <ProjectReference Include="..\DbStudio.Sources.Redis\DbStudio.Sources.Redis.csproj" />
    <ProjectReference Include="..\DbStudio.Sources.Mongo\DbStudio.Sources.Mongo.csproj" />
    <ProjectReference Include="..\DbStudio.Sources.Kafka\DbStudio.Sources.Kafka.csproj" />
    <ProjectReference Include="..\DbStudio.Logs\DbStudio.Logs.csproj" />
    <!-- Batch 3 (plan-batch3 D6): WP0 stubs; each package registers itself from its own IEngineModule. -->
    <ProjectReference Include="..\DbStudio.Providers.MySql\DbStudio.Providers.MySql.csproj" />
    <ProjectReference Include="..\DbStudio.Providers.ClickHouse\DbStudio.Providers.ClickHouse.csproj" />
    <ProjectReference Include="..\DbStudio.Providers.Snowflake\DbStudio.Providers.Snowflake.csproj" />
    <ProjectReference Include="..\DbStudio.Providers.Cassandra\DbStudio.Providers.Cassandra.csproj" />
    <ProjectReference Include="..\DbStudio.Sources.Elasticsearch\DbStudio.Sources.Elasticsearch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
