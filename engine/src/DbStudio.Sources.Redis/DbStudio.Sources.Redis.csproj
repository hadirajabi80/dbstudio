<Project Sdk="Microsoft.NET.Sdk">

  <!-- Redis source (docs/PLAN-M2.md section 5, package M2-R). StackExchange.Redis 2.8 (D7); RedisJSON and stream
       commands go through Execute. MONITOR uses a raw RESP connection (RawRedisConnection). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.58" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Commands\redis-commands.json" LogicalName="DbStudio.Sources.Redis.redis-commands.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbStudio.Core\DbStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbStudio.Sources.Redis.Tests" />
  </ItemGroup>

</Project>
